# ローカルPCから手動実行・テストする場合のみ、このファイルをコピーして `.env` を作成してください
# （`.env` は `.gitignore` によりGitHubへアップロードされません）

# X (Twitter) API v2 認証情報（GitHub Actionsでは Secrets から自動設定されます）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# YouTube Data API v3（discover_songs.py / fetch_metrics.py 手動実行用）
YOUTUBE_API_KEY=
